# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

.local-tools/
work/
tsconfig.tsbuildinfo

# Immutable local captures, execution records and service credentials
**/.navloom/evidence/
**/.navloom/runs/
**/.navloom/revisions/
**/.navloom/runtime.json
**/.navloom/service.lock
**/.navloom/graph.json
**/.navloom/plugins/versions/

# Machine-specific tools, credentials and captured application data
**/.gradle/
**/local.properties
**/verification/
**/.navloom/projects/
**/.navloom/plugins/.cache/
**/projects/*/.navloom/
/examples/agent-project/projects/
*.apk
*.aab
*.jks
*.keystore
*.p12
*.key
*.log

**/.navloom/plugins/active.json
**/.navloom/plugins/pins.json
